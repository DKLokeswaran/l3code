# git autocrlf=true converts LF to CRLF on Windows, causing issues with oxfmt
* text=auto eol=lf
# Batch files need CRLF for cmd.exe to parse them reliably.
*.cmd text eol=crlf
*.bat text eol=crlf
# Fork workflows are authoritative; upstream workflow changes are ignored on merge.
.github/workflows/* merge=ours
